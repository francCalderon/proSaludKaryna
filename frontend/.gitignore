# ==========================================
# GITIGNORE - FRONTEND (Next.js)
# ==========================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Lock file — generado por cada plataforma en su propio entorno.
# El lock de Windows contiene binarios SWC incompatibles con Linux.
package-lock.json

# Build de Next.js — .next/ SE INCLUYE EN GIT intencionalmente.
# El servidor cPanel no puede compilar Next.js (límite nproc del hosting).
# El flujo correcto es: build local → commit .next/ → push → servidor git pull.
# Solo se excluyen los archivos pesados que no se necesitan para servir la app:
.next/cache/
.next/dev/cache/
.next/trace
.next/trace-build
.next/*.trace

# Otros outputs
out/
build/
.vercel/
.turbo/

# Variables de entorno con secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Sistema
.DS_Store
Thumbs.db
