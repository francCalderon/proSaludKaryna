# ==========================================
# FRONTEND — NEXT.JS — Variables de entorno
# ==========================================
# Copiar como .env.local y completar los valores.
# Las variables NEXT_PUBLIC_* quedan expuestas en el bundle del navegador.
# Las variables sin prefijo NEXT_PUBLIC_ solo existen en el servidor (SSR).

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra al final)
# Local:       http://localhost:3000
# Producción:  https://procsalud.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de la API Strapi accesible desde el servidor Next.js (SSR)
# Local:       http://localhost:1337
# Producción:  https://api.procsalud.cl
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# ── Autenticación con Strapi ──────────────────────────────────────────────────
# Token de API (Read-only) generado en: Strapi Admin → Settings → API Tokens
# Dejar vacío en local si los endpoints son públicos.
STRAPI_API_TOKEN=

# ── Hostname de Strapi para next/image ───────────────────────────────────────
# Debe coincidir con el hostname en next.config.js → remotePatterns
# Local:       localhost
# Producción:  api.procsalud.cl
STRAPI_HOST=localhost
