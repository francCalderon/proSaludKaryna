# ==========================================
# BACKEND — STRAPI — Variables de entorno
# ==========================================
# Copiar este archivo como .env y completar los valores.
#
# BASE DE DATOS:
#   LOCAL  (desarrollo): no definir DATABASE_CLIENT → Strapi usa SQLite (.tmp/data.db)
#   PROD   (cPanel)    : definir DATABASE_CLIENT=mysql y las variables DATABASE_*

# ── Servidor ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# URL pública de la API (sin barra al final)
# Local:       http://localhost:1337
# Producción:  https://api.procsalud.cl
PUBLIC_URL=http://localhost:1337

NODE_ENV=development

# ── Seguridad — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" ──
APP_KEYS=clave1_base64,clave2_base64,clave3_base64,clave4_base64
API_TOKEN_SALT=reemplazar_con_32_bytes_base64
ADMIN_JWT_SECRET=reemplazar_con_32_bytes_base64
TRANSFER_TOKEN_SALT=reemplazar_con_32_bytes_base64
JWT_SECRET=reemplazar_con_32_bytes_base64

# ── Base de datos LOCAL — SQLite (predeterminado) ─────────────────────────────
# No se necesitan variables adicionales.
# Los datos se guardan en backend/.tmp/data.db

# ── Base de datos PRODUCCIÓN — MySQL (cPanel) ─────────────────────────────────
# Descomentar y completar para producción:
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=asitlpen_prosalud
# DATABASE_USERNAME=asitlpen_strapi
# DATABASE_PASSWORD=contraseña_mysql_aqui
# DATABASE_SSL=false

# ── CORS — dominio(s) del frontend que pueden llamar a la API ─────────────────
# Local:      http://localhost:3000
# Producción: https://procsalud.cl
CORS_ORIGIN=http://localhost:3000

# Opcional: duplicado de CORS_ORIGIN para compatibilidad con middlewares.js
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
